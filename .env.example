# Copy to .env.local (git-ignored) and fill in the values.
# .env.local holds DEV keys only: this folder syncs to OneDrive.
# Production values live only in Vercel -> Project -> Settings -> Environment Variables.

# Supabase -> Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://tudnruekssfzxhqkwgyd.supabase.co
# Supabase -> Project Settings -> API Keys -> Publishable key (sb_publishable_...). Safe in the browser: RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Supabase -> Project Settings -> API Keys -> Secret key (sb_secret_...). Server only; used for account deletion.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Google Cloud -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (public)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=30285081957-pejubc544ttl7h1jbj9007de2omp8vdu.apps.googleusercontent.com
